# Live traffic. Copy this file to .env.local, fill in the keys and restart `npm run dev`.
# Both are free. Without a key that source is skipped and the simulation fills in.

# Road sensors and incidents. Register at https://data.trafikverket.se and create a key.
TRAFIKVERKET_KEY=

# Trams, buses and ferries. Register at https://developer.vasttrafik.se, create an application,
# subscribe it to "Planera Resa v4", and copy its authentication key ("Autentiseringsnyckel").
VASTTRAFIK_KEY=
